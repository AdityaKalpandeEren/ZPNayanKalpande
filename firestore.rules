rules_version = '2';
// Nayan Kalpande – Firestore security rules
// Paste this in Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Each person can touch only the documents named with their own mobile number
    function isOwner(phone) {
      return signedIn() && request.auth.token.email == phone + '@nkzp.app';
    }
    function validPhone(phone) { return phone.matches('^[6-9][0-9]{9}$'); }
    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function validCommon(d) {
      return str(d.name, 2, 60) && str(d.school, 2, 120)
        && d.cls in ['6', '7'] && d.role in ['student', 'teacher'];
    }

    // Private profile: only the owner can read or change it
    match /users/{phone} {
      allow read, delete: if isOwner(phone);
      allow create, update: if isOwner(phone) && validPhone(phone)
        && request.resource.data.keys().hasOnly(['name', 'school', 'cls', 'role', 'consent', 'createdAt'])
        && validCommon(request.resource.data)
        && request.resource.data.consent == true
        && request.resource.data.createdAt is timestamp;
    }

    // Public Top-10 card: first name, school, class, role and minutes only
    match /stats/{phone} {
      allow read: if signedIn();
      allow delete: if isOwner(phone);
      allow create: if isOwner(phone) && validPhone(phone)
        && request.resource.data.keys().hasOnly(['name', 'school', 'cls', 'role', 'minutes', 'updatedAt'])
        && validCommon(request.resource.data)
        && request.resource.data.name.size() <= 30
        && request.resource.data.minutes == 0
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(phone)
        && request.resource.data.keys().hasOnly(['name', 'school', 'cls', 'role', 'minutes', 'updatedAt'])
        && validCommon(request.resource.data)
        && request.resource.data.name.size() <= 30
        && (
          // profile change: minutes and time stay the same
          (request.resource.data.minutes == resource.data.minutes
            && request.resource.data.updatedAt == resource.data.updatedAt)
          ||
          // usage: add 1 to 5 minutes, at most once every 4 minutes (stops cheating)
          (request.resource.data.minutes > resource.data.minutes
            && request.resource.data.minutes <= resource.data.minutes + 5
            && request.resource.data.updatedAt == request.time
            && request.time > resource.data.updatedAt + duration.value(4, 'm')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['minutes', 'updatedAt']))
        );
    }

    // Everything else is closed
    match /{document=**} { allow read, write: if false; }
  }
}
